# =============================================================================
# Payment Defense Twin — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ---- Database (RDS PostgreSQL) ------------------------------------------------
RDS_HOST=your-rds-endpoint.region.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=postgres
RDS_USERNAME=postgres

# Auth mode: "password" (uses RDS_PASSWORD) or "iam" (auto-generates token via AWS CLI)
DB_AUTH_MODE=iam
# RDS_PASSWORD=your-master-password   # only needed if DB_AUTH_MODE=password
DB_SSL_MODE=require

# Connection pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ---- S3 Artifact Storage -----------------------------------------------------
AWS_REGION=us-east-1
AWS_PROFILE=default
S3_BUCKET=your-payment-defense-twin-bucket
S3_PREFIX=payment-defense-twin

# ---- API / Server ------------------------------------------------------------
API_PORT=8000

# ---- Scheduler ---------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_FAMILIES=5
SCHEDULER_SKIP_TRAIN_V1=true
SCHEDULER_AUTO_SWAP=true

# ---- Evidence / Models -------------------------------------------------------
EVIDENCE_BUFFER_PATH=data/adversarial_buffer/evidence.jsonl
FRAUDSHIELD_MODEL_DIR=data/models

# ---- Red Team LLM ------------------------------------------------------------
RED_TEAM_USE_LLM=false

# ---- LLM Provider Keys (pick one or more) -----------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...
# AWS_BEDROCK_REGION=us-east-1
