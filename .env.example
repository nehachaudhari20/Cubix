# PostgreSQL (Docker Compose service name is "postgres")
POSTGRES_DB=payment_defense_twin
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production

# Backend database URL
# - Local uvicorn (no Docker DB): sqlite:///./data/platform.db
# - Docker Compose: use host "postgres" (NOT localhost)
DB_URL=postgresql+psycopg://postgres:change_me_in_production@postgres:5432/payment_defense_twin

# Frontend (baked at Docker build time for production images)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# LLM — set RED_TEAM_USE_LLM=true and provide at least one key
RED_TEAM_USE_LLM=true
LLM_PROVIDER=cohere
COHERE_API_KEY=YOUR_KEY_HERE
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
