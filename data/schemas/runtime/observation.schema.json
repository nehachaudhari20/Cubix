{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "observation.schema.json",
  "title": "Canonical immutable observation — the central handoff object",
  "type": "object",
  "required": ["observation_id", "action_type", "decision", "timestamp"],
  "properties": {
    "observation_id": {"type": "string"},
    "experiment_id": {"type": ["string", "null"]},
    "campaign_id": {"type": ["string", "null"]},
    "attack_vector_id": {"type": ["string", "null"]},
    "attack_instance_id": {"type": ["string", "null"]},
    "attack_family_id": {"type": ["string", "null"]},
    "attack_variant_id": {"type": ["string", "null"]},
    "transaction_id": {"type": ["string", "null"]},
    "action_type": {"type": "string"},
    "environment_version": {"type": ["string", "null"]},
    "model_version": {"type": ["string", "null"]},
    "feature_version": {"type": ["string", "null"]},
    "state_before": {"type": "object"},
    "state_after": {"type": "object"},
    "features": {"type": "object"},
    "signals_observed": {"type": "array", "items": {"type": "string"}},
    "controls_triggered": {"type": "array", "items": {"type": "string"}},
    "rule_outputs": {"type": "object"},
    "ml_score": {"type": ["number", "null"]},
    "behavioral_outputs": {"type": "object"},
    "graph_outputs": {"type": "object"},
    "unified_risk": {"type": ["number", "null"]},
    "authorization_decision": {"type": ["string", "null"]},
    "decision": {"type": "string"},
    "outcome": {"type": ["string", "null"]},
    "reason": {"type": ["string", "null"]},
    "timestamp": {"type": "string"}
  },
  "additionalProperties": true
}
