# =============================================================================
# Payment Defense Twin — Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# ---- Database (RDS PostgreSQL) ------------------------------------------------
RDS_HOST=your-rds-endpoint.region.rds.amazonaws.com
RDS_PORT=5432
RDS_DB_NAME=postgres
RDS_USERNAME=postgres

# Auth mode: "password" (uses RDS_PASSWORD) or "iam" (auto-generates token via AWS CLI)
DB_AUTH_MODE=iam
# RDS_PASSWORD=your-master-password   # only needed if DB_AUTH_MODE=password
DB_SSL_MODE=require

# Connection pooling
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=3600

# ---- S3 Artifact Storage -----------------------------------------------------
AWS_REGION=eu-north-1
AWS_PROFILE=default
S3_BUCKET=your-payment-defense-twin-bucket
S3_PREFIX=payment-defense-twin

# ---- API / Server ------------------------------------------------------------
API_PORT=8000

# ---- Scheduler ---------------------------------------------------------------
SCHEDULER_ENABLED=false
SCHEDULER_INTERVAL_MINUTES=60
SCHEDULER_FAMILIES=5
SCHEDULER_SKIP_TRAIN_V1=true
SCHEDULER_AUTO_SWAP=true

# ---- Evidence / Models -------------------------------------------------------
EVIDENCE_BUFFER_PATH=data/adversarial_buffer/evidence.jsonl
FRAUDSHIELD_MODEL_DIR=data/models

# ---- Red Team LLM (Cohere recommended) ---------------------------------------
RED_TEAM_USE_LLM=true
LLM_PROVIDER=cohere
COHERE_API_KEY=your-cohere-api-key
RED_TEAM_LLM_MODEL=command-r-08-2024
# RED_TEAM_ATTACK_ENGINE_STRICT_LLM=false  # set true to have LLM filter variations
# RED_TEAM_ENGINE_EXECUTE_ALL=true
# RED_TEAM_ENGINE_MAX_VARIATIONS=20
# RED_TEAM_MUTATE_BEFORE_JUMP=2
# RED_TEAM_LINEAR_RETRIES=3

# ---- Alternate LLM providers -------------------------------------------------
# OPENAI_API_KEY=sk-...
# GOOGLE_API_KEY=...
# GEMINI_API_KEY=...
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
