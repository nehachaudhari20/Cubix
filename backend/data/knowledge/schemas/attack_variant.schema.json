{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "attack_variant.schema.json",
  "title": "Attack variant (meaningful variation of a family, not an instance)",
  "type": "object",
  "required": ["variant_id", "family_id", "name", "origin"],
  "properties": {
    "variant_id": {"type": "string", "minLength": 1},
    "family_id": {"type": "string", "minLength": 1},
    "name": {"type": "string", "minLength": 1},
    "slug": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "origin": {"type": "string", "enum": ["source_backed", "implementation_derived"]},
    "origin_note": {"type": ["string", "null"]},
    "sandbox_executable": {"type": ["boolean", "null"]},
    "evidence_ids": {"type": "array", "items": {"type": "string", "minLength": 1}}
  },
  "additionalProperties": false
}
